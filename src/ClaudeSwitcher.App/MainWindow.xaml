<Window x:Class="ClaudeSwitcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Switcher"
        Height="600" Width="480"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI" FontSize="13"
        Foreground="{StaticResource FgMain}"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BgMid}" Padding="16,14">
            <StackPanel>
                <TextBlock Text="CLAUDE SWITCHER" FontSize="15" FontWeight="Bold"
                           Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ActiveLabel" Text="Active: —" Margin="0,2,0,0"
                           FontSize="11" Foreground="{StaticResource FgDim}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="BridgeLabel" Text="Browser bridge: disconnected" Margin="0,2,0,0"
                           FontSize="10" Foreground="{StaticResource FgDim}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Profiles list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
            <ItemsControl x:Name="ProfilesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Settings row -->
        <Border Grid.Row="2" Padding="12,6" Background="{StaticResource BgMid}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <CheckBox x:Name="RelaunchToggle" Foreground="{StaticResource FgMain}"
                          Content="Auto-relaunch Claude Desktop / Antigravity after switch"
                          Checked="OnRelaunchChanged" Unchecked="OnRelaunchChanged"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Padding="12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AddBtn" Style="{StaticResource AccentButton}" Content="+ Add Profile"
                        Click="OnAddClicked"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
